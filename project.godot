; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KnowledgeAdmin"
run/main_scene="res://content/scenes/desktop/boot_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://bpnhdfeeso1o2"
config/icon="res://content/assets/branding/icon.svg"

[autoload]

SaveDirectory="*res://src/save_directory.gd"
MCPRuntimeBridge="*uid://wk2yhw3winuo"
DialogueManager="*uid://c3rodes2l3gxb"
DebugSettings="*res://src/debug_settings.gd"
UiSettings="*res://src/ui_settings.gd"
ShortcutSettings="*res://src/shortcut_settings.gd"
WallpaperSettings="*res://src/wallpaper_settings.gd"
WindowManager="*res://src/window_manager.gd"
App="*res://content/scenes/system/app.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/godot_dotnet_mcp/plugin.cfg", "res://addons/gut/plugin.cfg")

[global_group]

debugUI="debug控制的全局操纵界面"

[gui]

theme/custom="res://content/assets/UI/app_theme.tres"
theme/custom_font="uid://c76ct6f0pkvcl"

[internationalization]

locale/translations_pot_files=PackedStringArray("res://content/dialogue/story/chapter_prologue.dialogue", "res://content/dialogue/story/nathan_conversation.dialogue", "res://content/dialogue/story/ch1_intro.dialogue", "res://content/dialogue/story/ch1_explain.dialogue", "res://content/dialogue/story/ch1_trust.dialogue", "res://content/dialogue/story/ch1_warning.dialogue", "res://content/dialogue/story/ch1_choice.dialogue", "res://content/dialogue/story/ch1_end.dialogue", "res://content/dialogue/story/ch1_past.dialogue", "res://content/dialogue/story/ch1_revelation.dialogue", "res://content/dialogue/tutorial/main_menu.dialogue", "res://content/dialogue/tutorial/deck_list.dialogue", "res://content/dialogue/tutorial/note_list.dialogue", "res://content/dialogue/tutorial/study.dialogue", "res://content/dialogue/tutorial/debug_panel.dialogue", "res://content/dialogue/tutorial/ai_debug.dialogue", "res://content/dialogue/story/ch1_bond_epilogue.dialogue", "res://content/dialogue/story/ch1_bond_memory_1.dialogue", "res://content/dialogue/story/ch1_bond_memory_2.dialogue", "res://content/dialogue/story/ch1_bond_memory_3.dialogue", "res://content/dialogue/story/ch2_choice.dialogue", "res://content/dialogue/story/ch2_connection.dialogue", "res://content/dialogue/story/ch2_end.dialogue", "res://content/dialogue/story/ch2_protocol.dialogue", "res://content/dialogue/story/ch2_revelation.dialogue", "res://content/dialogue/story/ch2_survivor.dialogue", "res://content/dialogue/story/ch2_trojan.dialogue", "res://content/dialogue/story/ch2_xanaku.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"

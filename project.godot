; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KnowledgeAdmin"
run/main_scene="res://scenes/desktop/boot_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://bpnhdfeeso1o2"
config/icon="res://icon.svg"

[autoload]

MCPRuntimeBridge="*uid://wk2yhw3winuo"
DialogueManager="*uid://c3rodes2l3gxb"
DebugSettings="*res://src/debug_settings.gd"
UiSettings="*res://src/ui_settings.gd"
WindowManager="*res://src/window_manager.gd"
App="*res://src/app.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/godot_dotnet_mcp/plugin.cfg", "res://addons/gut/plugin.cfg")

[global_group]

debugUI="debug控制的全局操纵界面"

[gui]

theme/custom="res://assets/UI/app_theme.tres"
theme/custom_font="uid://c76ct6f0pkvcl"

[internationalization]


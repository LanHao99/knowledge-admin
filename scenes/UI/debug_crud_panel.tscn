[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/debug_crud_panel.gd" id="1_dbg"]

[node name="DebugCrudPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dbg")

[node name="RootMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="MainVBox" type="VBoxContainer" parent="RootMargin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Toolbar" type="HBoxContainer" parent="RootMargin/MainVBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="RootMargin/MainVBox/Toolbar"]
layout_mode = 2
text = "Deck + Notes CRUD Debug Panel"
size_flags_horizontal = 3

[node name="ClearAllDataButton" type="Button" parent="RootMargin/MainVBox/Toolbar"]
layout_mode = 2
text = "Clear All Data"
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)

[node name="RefreshAllButton" type="Button" parent="RootMargin/MainVBox/Toolbar"]
layout_mode = 2
text = "Refresh All"

[node name="MainHSplit" type="HSplitContainer" parent="RootMargin/MainVBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 4

[node name="ContentHBox" type="HBoxContainer" parent="RootMargin/MainVBox/MainHSplit"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="DeckPanel" type="PanelContainer" parent="RootMargin/MainVBox/MainHSplit/ContentHBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="DeckVBox" type="VBoxContainer" parent="RootMargin/MainVBox/MainHSplit/ContentHBox/DeckPanel"]
layout_mode = 2

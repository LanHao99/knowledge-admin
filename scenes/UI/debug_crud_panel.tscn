columns = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 4

[node name="DeckNameLabel" type="Label" parent="RootMargin/MainVBox/MainHSplit/ContentHBox/DeckPanel/DeckVBox/DeckForm"]
layout_mode = 2
text = "Name"
tooltip_text = "Create: new deck name | Update: new name for target deck"

[node name="DeckNameInput" type="LineEdit" parent="RootMargin/MainVBox/MainHSplit/ContentHBox/DeckPanel/DeckVBox/DeckForm"]
layout_mode = 2
size_flags_horizontal = 3
